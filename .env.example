# Les origines localhost / 127.0.0.1 (tous ports, ex. :3002) sont toujours autorisées.
# Exemple : https://luiza.ibelucky.com,http://localhost:3002
CORS_ORIGINS=*

# Laisser vide pour laisser l'API ouverte en local (MVP).
API_KEY=
