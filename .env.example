PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3307
DB_NAME=luiza_mining_safe
DB_USER=root
DB_PASSWORD=

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

